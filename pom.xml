<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.unideb.inf</groupId>
    <artifactId>restful-shakespeare-client</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>RESTful Shakespeare client</name>
    <description>A client of the RESTful Shakespeare API, generated from its OpenAPI description</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>hu.unideb.inf.shakespeare.client.App</exec.mainClass>
        <spring-framework.version>7.1.0-RC1</spring-framework.version>
        <openapi-generator.version>7.27.0</openapi-generator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- RestClient, and the HTTP interfaces (@HttpExchange) the generated code consists of -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- HttpServiceProxyFactory needs it to implement the HTTP interfaces (proxies, conversion) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- The @Generated annotation of the generated code -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Generates the client code from the OpenAPI description into
                     target/generated-sources/openapi (generate-sources phase, i.e.,
                     before compiling), and adds it to the sources to compile -->
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <!-- OpenAPI Generator does not support OpenAPI 3.2 yet (see README.md) -->
                            <inputSpec>${project.basedir}/openapi/openapi-3.1.yaml</inputSpec>
                            <!-- Spring HTTP interfaces: Java interfaces with @HttpExchange
                                 annotations, implemented by Spring at runtime -->
                            <generatorName>spring</generatorName>
                            <library>spring-http-interface</library>
                            <apiPackage>hu.unideb.inf.shakespeare.client.api</apiPackage>
                            <modelPackage>hu.unideb.inf.shakespeare.client.model</modelPackage>
                            <!-- Only the interfaces (no pom.xml, README, configuration classes) -->
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <!-- The parser reports a false error for the description (see README.md) -->
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot4>true</useSpringBoot4>
                                <!-- One interface per tag (controller), e.g., PlayControllerApi -->
                                <useTags>true</useTags>
                                <useJspecify>true</useJspecify>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
